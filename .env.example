# -----------------------------------------------------------------------------
# Shared
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# apps/web (Mini App) — copy to apps/web/.env.local for local dev
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Telegram username used for "Chat with sales" deep links. No @ prefix.
# Leave empty to hide the Chat-with-sales button.
NEXT_PUBLIC_SALES_TG_USERNAME=

# Bot token from @BotFather for @ithinkuzbot.
# Used server-side only to HMAC-verify Telegram WebApp initData.
# The mini app does NOT run a bot process — the token is only for validation.
TELEGRAM_BOT_TOKEN=

# amoCRM (Phase 1 ships stubbed — these are unused until real integration lands)
AMOCRM_SUBDOMAIN=
AMOCRM_ACCESS_TOKEN=
AMOCRM_PIPELINE_ID=
AMOCRM_RESPONSIBLE_USER_ID=
AMOCRM_CF_SERVICE_ID=
AMOCRM_CF_DESCRIPTION_ID=
AMOCRM_CF_TG_USERNAME_ID=
AMOCRM_CF_SOURCE_ID=
