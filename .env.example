# -----------------------------------------------------------------------------
# Shared
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# apps/web (Mini App) — copy to apps/web/.env.local for local dev
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Telegram username used for "Chat with sales" deep links. No @ prefix.
# Leave empty to hide the Chat-with-sales button.
NEXT_PUBLIC_SALES_TG_USERNAME=

# Bot token from @BotFather for @ithinkuzbot. Used server-side to HMAC-verify
# Telegram WebApp initData and to post fallback leads to SALES_FALLBACK_CHAT_ID.
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Lead intake (/api/lead for the Mini App, /api/site-lead for ithink.uz)
# Production requires AMOCRM_SUBDOMAIN, AMOCRM_ACCESS_TOKEN and
# TELEGRAM_BOT_TOKEN (the Vercel build or the server start fails without them).
# Without AMOCRM_RESPONSIBLE_USER_ID amoCRM assigns the integration owner,
# without SALES_FALLBACK_CHAT_ID there is no backup when amoCRM is down, and
# without TURNSTILE_SECRET_KEY /api/site-lead answers 503.
# Outside production a missing token runs amoCRM in stub mode.
# -----------------------------------------------------------------------------
AMOCRM_SUBDOMAIN=ithink
# Long-lived token of the write-enabled private integration "ITHINK LEADS".
# Not the read-only audit token.
AMOCRM_ACCESS_TOKEN=
# "Воронка продаж" / "Новая заявка"
AMOCRM_PIPELINE_ID=6434662
AMOCRM_STATUS_ID=72345034
AMOCRM_RESPONSIBLE_USER_ID=

# Pending list fields. Enum maps are JSON keyed by our values, e.g.
# AMOCRM_PRODUCT_ENUMS={"managed-it-services":123,"it-infrastructure":124}
# AMOCRM_CHANNEL_ENUMS={"site":201,"telegram_miniapp":202}
# AMOCRM_BUDGET_ENUMS={"lt_1k":301,"1k_5k":302,"5k_15k":303,"gt_15k":304,"unknown":305}
AMOCRM_CF_PRODUCT_ID=
AMOCRM_PRODUCT_ENUMS=
AMOCRM_CF_CHANNEL_ID=
AMOCRM_CHANNEL_ENUMS=
AMOCRM_CF_BUDGET_ID=
AMOCRM_BUDGET_ENUMS=
# AMOCRM_COMPANY_SIZE_ENUMS={"1_10":401,"11_50":402,"51_200":403,"200_plus":404}
AMOCRM_CF_COMPANY_SIZE_ID=
AMOCRM_COMPANY_SIZE_ENUMS=

# Sales chat that receives a lead when amoCRM is unreachable. The bot must be a
# member of this chat.
SALES_FALLBACK_CHAT_ID=

# Cloudflare Turnstile secret for /api/site-lead.
TURNSTILE_SECRET_KEY=
# Comma-separated origins allowed to call /api/site-lead.
SITE_ORIGINS=https://ithink.uz,https://www.ithink.uz
